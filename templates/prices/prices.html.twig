{# templates/prices/prices.html.twig #}
{% extends 'base.html.twig' %}

{% block content %}
    <div id="prices-page">
        <h1 class="text-center">Válaszd ki a számodra tökéletes csomagot!</h1>
        <div id="prices" class="row">
            <div class="col col-4 text-center">
                <div class="price">
                    <div class="price-name">
                        Alap csomag
                    </div>
                    <hr class="solid">
                    <div class="price-value">
                        3900 Ft
                    </div>
                    <div class="price-information">
                        <ul>
                            <li>Személyre szabott önéletrajz</li>
                            <li>SEO optimalizálás</li>
                            <li>3 választható sablon</li>
                            <li>48-72 órán belül kész</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col col-4 text-center">
                <div class="price most-popular">
                    <div class="popular">
                        Legnépszerűbb
                    </div>
                    <div class="price-name">
                        Prémium csomag
                    </div>
                    <hr class="solid">
                    <div class="price-value">
                        4900 Ft
                    </div>
                    <div class="price-information">
                        <ul>
                            <li>Személyre szabott önéletrajz</li>
                            <li>Kulcsszó optimalizálás ATS rendszerekhez</li>
                            <li>Egyszeri újratervezés</li>
                            <li>Korlátlan sablon választási lehetőség</li>
                            <li>24-48 órán belül kész</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col col-4 text-center">
                <div class="price">
                    <div class="price-name">
                        Prémium+ csomag
                    </div>
                    <hr class="solid">
                    <div class="price-value">
                        6000 Ft
                    </div>
                    <div class="price-information">
                        <ul>
                            <li>Kész önéletrajz 24 óra alatt</li>
                            <li>Kétszeri újratervezés</li>
                            <li>Unlimited bandwidth</li>
                            <li>Előnézet</li>
                            <li>asdasd</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}