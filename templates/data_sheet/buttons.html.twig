<div id="buttons">
    {% if step > 1 %}
        <button class="step-button button-hover" data-step="{{ step-1 }}" title="Vissza" aria-label="Vissza">Vissza</button>
    {% endif %}
    {% if step != lastStep %}
        {% set buttonTitle = 'Tovább' %}
    {% else %}
        {% set buttonTitle = 'Befejezés' %}
    {% endif %}
    <button class="step-button button-hover" data-step="{{ step+1 }}" title="{{ buttonTitle }}" aria-label="{{ buttonTitle }}">{{ buttonTitle }}</button>
</div>