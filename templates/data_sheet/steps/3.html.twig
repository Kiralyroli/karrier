<div class="content-header">Tölts fel egy képet magadról (nem kötelező).</div>
<div class="row justify-content-center content-wrapper">
    <div class="col-md-5">
        <div class="form-step">
            <h1 class="form-title">Fénykép feltöltése</h1>
            <p class="form-subtitle">FONTOS:</p>
            <p class="form-notes">Nem kötelező, de előnyt jelent, ha:</p>
            <ul class="form-notes">
                <li>5 éven belüli</li>
                <li>hivatalos</li>
                <li>ízléses</li>
            </ul>
            <p class="form-notes">(Amennyiben a fénykép nem felel meg az elvárásoknak, nem helyezzük el az önéletrajzon)</p>
        </div>
    </div>

    <div class="col-md-2 position-relative step-wrapper">
        <div class="step-line"></div>
        <div class="step-number"
             style="top: calc(8% + ({{ (step - 1) * (85 / (lastStep - 1)) }}%));
                     left: calc(10% + ({{ (step - 1) * (80 / (lastStep - 1)) }}%));">
            {{ step }}
        </div>
    </div>

    <div class="col-md-5">
        {% include 'components/drop_area.html.twig' with {
            'uploaded_file': formData.uploaded_cv_image|default(null),
            'uploadedFileSelector': '#uploaded-cv-image',
            'areaType': 'image'
        } %}
        <form id="data-form">
            <input type="hidden" id="uploaded-cv-image" name="uploaded_cv_image" value="{% if formData.uploaded_cv_image is defined %}{{ formData.uploaded_cv_image }}{% endif %}">
        </form>
    </div>
</div>
{% include 'data_sheet/buttons.html.twig' %}