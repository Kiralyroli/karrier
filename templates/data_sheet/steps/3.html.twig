<div class="content-header">Tölts fel egy képet magadról (nem kötelező).</div>
<div class="row justify-content-center content-wrapper">
    <div class="col-md-5">
        <div class="form-step">
            <h1 class="form-title">Fénykép feltöltése</h1>
            <p class="form-subtitle">FONTOS:</p>
            <p class="form-notes">Nem kötelező, de előnyt jelent, ha:</p>
            <ul class="form-notes">
                <li>5 éven belüli</li>
                <li>hivatalos</li>
                <li>ízléses</li>
            </ul>
            <p class="form-notes">(Amennyiben a fénykép nem felel meg az elvárásoknak, nem helyezzük el az önéletrajzon)</p>
        </div>
    </div>

    <div class="col-md-2 position-relative step-wrapper">
        <div class="step-line"></div>
        <div class="step-number"
             style="top: calc(8% + ({{ (step - 1) * (85 / (lastStep - 1)) }}%));
                     left: calc(10% + ({{ (step - 1) * (80 / (lastStep - 1)) }}%));">
            {{ step }}
        </div>
    </div>

    <div class="col-md-5">
        <form id="upload-form" class="file-upload-form">
            <div id="drop-area" class="drop-area">
                <p class="drop-text">Húzd ide a fájlt</p>
                <p class="or-text">vagy</p>
                <label for="file-input" class="browse-button">Tallózás</label>
                <input type="file" id="file-input" accept=".jpeg,.png,.jpg,.webp" name="file" hidden>
            </div>
        </form>
        <form id="data-form">
            <input type="hidden" id="uploaded-cv-image" name="uploaded_cv_image">
        </form>
    </div>
</div>
{% include 'data_sheet/buttons.html.twig' %}

<script>
    $(document).ready(function () {
        let dropArea = $('#drop-area');
        let fileInput = $('#file-input');
        let fileNameDisplay = $('#uploaded-cv-image');

        $('.browse-button').off('click').on('click', function (e) {
            e.preventDefault();
            fileInput.click();
        });

        fileInput.off('change').on('change', function () {
            if (this.files.length > 0) {
                let file = this.files[0];

                if (!isValidFileType(file)) {
                    alert('Csak képeket tölthetsz fel!');
                    fileInput.val('');
                    return;
                }

                handleFiles(this.files);
                $(this).val('');
            }
        });

        dropArea.on('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).addClass('dragover');
        });

        dropArea.on('dragleave', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('dragover');
        });

        dropArea.on('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('dragover');

            let files = e.originalEvent.dataTransfer.files;
            if (files.length > 0 && isValidFileType(files[0])) {
                handleFiles(files);
            } else {
                alert('Csak képeket tölthetsz fel!');
            }
        });

        function isValidFileType(file) {
            let allowedTypes = ['image/jpeg', 'image/png', 'image/jpg', 'image/webp'];
            return allowedTypes.includes(file.type);
        }

        function handleFiles(files) {
            if (files.length > 0) {
                let formData = new FormData();
                formData.append('file', files[0]);

                $.ajax({
                    url: '/upload-file',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        fileNameDisplay.val(response.file);
                        alert('Fájl sikeresen feltöltve!');
                    },
                    error: function (xhr, status, error) {
                        console.error('Hiba történt:', error);
                    }
                });
            }
        }
    });

</script>