<div class="content-header">Ha van, töltsd fel meglévő önéletrajzodat PDF vagy Word formátumban.</div>
<div class="row justify-content-center content-wrapper">
    <div class="col-md-5">
        <div class="form-step">
            <h1 class="form-title">Önéletrajz feltöltése</h1>
        </div>
    </div>

    <div class="col-md-2 position-relative step-wrapper">
        <div class="step-line"></div>
        <div class="step-number"
             style="top: calc(8% + ({{ (step - 1) * (85 / (lastStep - 1)) }}%));
                     left: calc(10% + ({{ (step - 1) * (80 / (lastStep - 1)) }}%));">
            {{ step }}
        </div>
    </div>

    <div class="col-md-5">
        {% include 'components/drop_area.html.twig' with {
            'uploaded_file': formData.uploaded_cv_file|default(null),
            'uploadedFileSelector': '#uploaded-cv-file',
            'areaType': 'doc'
        } %}
        <form id="data-form">
            <input type="hidden" id="uploaded-cv-file" name="uploaded_cv_file" value="{% if formData.uploaded_cv_file is defined %}{{ formData.uploaded_cv_file }}{% endif %}">
        </form>
    </div>
</div>
{% include 'data_sheet/buttons.html.twig' %}