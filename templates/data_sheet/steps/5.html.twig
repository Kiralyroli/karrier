<div class="content-header">Ha tudod, add meg, milyen pozícióra vagy iparágba szeretnél pályázni! Ha van konkrét álláshirdetés, másold be a linkjét, hogy még pontosabb tanácsokat adhassunk neked!</div>
<div class="row justify-content-center content-wrapper">
    <div class="col-md-5">
        <div class="form-step">
            <h1 class="form-title">Célok és álláshirdetés</h1>
            <p class="form-subtitle">FONTOS:</p>
            <ul class="form-notes">
                <li>Pozíciót vagy iparágat mindenképpen jelölj meg, ha szükséges, több pozíciót is megjelölhetsz</li>
            </ul>
        </div>
    </div>

    <div class="col-md-2 position-relative step-wrapper">
        <div class="step-line"></div>
        <div class="step-number"
             style="top: calc(8% + ({{ (step - 1) * (85 / (lastStep - 1)) }}%));
                     left: calc(10% + ({{ (step - 1) * (80 / (lastStep - 1)) }}%));">
            {{ step }}
        </div>
    </div>

    <div class="col-md-5">
        <form id="data-form">
            <div id="position-container">
                {% if formData.jobs is defined and formData.jobs is not empty %}
                    {% for job in formData.jobs %}
                        <div class="position-group">
                            <div class="mb-3">
                                <input type="text" name="job_position[{{ loop.index0 }}]" class="form-control" placeholder="Pozíció" aria-label="Pozíció" value="{{ job.position }}">
                            </div>
                            <div class="mb-3">
                                <input type="text" name="job_industry[{{ loop.index0 }}]" class="form-control" placeholder="Iparág" aria-label="Iparág" value="{{ job.industry }}">
                            </div>
                            <div class="mb-3">
                                <input type="text" name="job_link[{{ loop.index0 }}]" class="form-control" placeholder="Álláshirdetés link" aria-label="Álláshirdetés link" value="{{ job.link }}">
                            </div>
                            <div class="remove-button-container"><div class="remove-button"><i class="bi bi-x-circle"></i> Törlés</div></div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="position-group">
                        <div class="mb-3">
                            <input type="text" name="job_position[0]" class="form-control" placeholder="Pozíció" aria-label="Pozíció">
                        </div>
                        <div class="mb-3">
                            <input type="text" name="job_industry[0]" class="form-control" placeholder="Iparág" aria-label="Iparág">
                        </div>
                        <div class="mb-3">
                            <input type="text" name="job_link[0]" class="form-control" placeholder="Álláshirdetés link" aria-label="Álláshirdetés link">
                        </div>
                        <div class="remove-button-container"><div class="remove-button"><i class="bi bi-x-circle"></i> Törlés</div></div>
                    </div>
                {% endif %}
            </div>

            <div id="add-button-container"><div id="add-button">+ Pozíció</div></div>
        </form>
    </div>
</div>

{% include 'data_sheet/buttons.html.twig' %}

<script>
    $(document).ready(function() {
        function updateIndexes() {
            $("#position-container .position-group").each(function(index) {
                $(this).find("input[name^='job_position']").attr("name", "job_position[" + index + "]");
                $(this).find("input[name^='job_industry']").attr("name", "job_industry[" + index + "]");
                $(this).find("input[name^='job_link']").attr("name", "job_link[" + index + "]");
            });
        }

        $("#add-button").click(function() {
            let count = $("#position-container .position-group").length;
            let newGroup = `
            <div class="position-group">
                <div class="mb-3">
                    <input type="text" name="job_position[${count}]" class="form-control" placeholder="Pozíció" aria-label="Pozíció">
                </div>
                <div class="mb-3">
                    <input type="text" name="job_industry[${count}]" class="form-control" placeholder="Iparág" aria-label="Iparág">
                </div>
                <div class="mb-3">
                    <input type="text" name="job_link[${count}]" class="form-control" placeholder="Álláshirdetés link" aria-label="Álláshirdetés link">
                </div>
                <div class="remove-button-container"><div class="remove-button"><i class="bi bi-x-circle"></i> Törlés</div></div>
            </div>
        `;
            $("#position-container").append(newGroup);
        });

        $(document).on("click", ".remove-button", function() {
            $(this).closest(".position-group").remove();
            updateIndexes();
        });
    });
</script>