<div class="g-recaptcha{% if validations.recaptcha is defined %} {{ validations.recaptcha }}{% endif %}"
     data-sitekey="{{ recaptcha_site_key }}" aria-describedby="validationServerRecaptchaFeedback"></div>
<div id="validationServerRecaptchaFeedback" class="invalid-feedback">
    Helytelen captcha ellenőrzés! Kérjük, hogy pipálja be a négyzetet!
</div>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>