{% extends 'base.html.twig' %}

{% block content %}
    <div id="cart-page">
        <div class="container my-5">
            <h2 class="text-center mb-4">Számlázási adatok</h2>

            <form action="{{ path('checkout') }}" method="POST" id="checkout-form" class="needs-validation" novalidate>
                <div class="row gy-4">
                    <div class="col-12 col-lg-7">
                        <div class="card p-3 shadow-sm">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <input type="text" name="lastname" class="form-control {% if validations.lastname is defined %}{{ validations.lastname }}{% endif %}" placeholder="Vezetéknév" value="{% if data.lastname is defined %}{{ data.lastname }}{% endif %}" required>
                                    <div class="invalid-feedback">Kérlek, add meg a vezetékneved!</div>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" name="firstname" class="form-control {% if validations.firstname is defined %}{{ validations.firstname }}{% endif %}" placeholder="Keresztnév" value="{% if data.firstname is defined %}{{ data.firstname }}{% endif %}" required>
                                    <div class="invalid-feedback">Kérlek, add meg a keresztneved!</div>
                                </div>
                                <div class="col-12">
                                    <input type="email" name="email" class="form-control {% if validations.email is defined %}{{ validations.email }}{% endif %}" placeholder="Email cím" value="{% if data.email is defined %}{{ data.email }}{% endif %}" required>
                                    <div class="invalid-feedback">Érvényes email cím szükséges!</div>
                                </div>
                                <div class="col-12">
                                    <input type="tel" name="phone" class="form-control {% if validations.phone is defined %}{{ validations.phone }}{% endif %}" placeholder="Telefonszám" value="{% if data.phone is defined %}{{ data.phone }}{% endif %}" required>
                                    <div class="invalid-feedback">Add meg a telefonszámod!</div>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" name="country" class="form-control {% if validations.country is defined %}{{ validations.country }}{% endif %}" placeholder="Ország" value="{% if data.country is defined %}{{ data.country }}{% endif %}" required>
                                    <div class="invalid-feedback">Add meg az országot!</div>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" name="zipcode" class="form-control {% if validations.zipcode is defined %}{{ validations.zipcode }}{% endif %}" placeholder="Irányítószám" value="{% if data.zipcode is defined %}{{ data.zipcode }}{% endif %}" required>
                                    <div class="invalid-feedback">Add meg az irányítószámot!</div>
                                </div>
                                <div class="col-12">
                                    <input type="text" name="city" class="form-control {% if validations.city is defined %}{{ validations.city }}{% endif %}" placeholder="Város" value="{% if data.city is defined %}{{ data.city }}{% endif %}" required>
                                    <div class="invalid-feedback">Add meg a várost!</div>
                                </div>
                                <div class="col-12">
                                    <input type="text" name="address" class="form-control {% if validations.address is defined %}{{ validations.address }}{% endif %}" placeholder="Utca, házszám" value="{% if data.address is defined %}{{ data.address }}{% endif %}" required>
                                    <div class="invalid-feedback">Add meg a címet!</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-5">
                        <div class="card p-3 shadow-sm h-100">
                            <h3 class="fw-bold">Rendelés összesítő</h3>

                            <p class="mb-1">
                                <strong>{{ package.level }} {{ package.title }}</strong>
                                <span class="float-end">{{ package.price|price }}</span>
                            </p>

                            <ul class="list-unstyled">
                                {% for feature in package.features %}
                                    <li><i class="bi bi-check2"></i> {{ feature }}</li>
                                {% endfor %}
                            </ul>

                            <hr class="hr"/>

                            <div class="payment-method">
                                <h4 class="fw-bold">Fizetési mód</h4>
                                <p class="fs-5">Bankkártyás fizetés Barionnal</p>
                                <img src="{{ asset('images/barion-logo.svg') }}" alt="Barion bankkártyás fizetés" class="img-fluid" style="max-height: 50px;">
                                <p class="text-muted small mt-2">
                                    A kényelmes és biztonságos online fizetést a Barion Payment Zrt. biztosítja.<br>
                                    Magyar Nemzeti Bank engedély száma: H-EN-I-1064/2013<br>
                                    Bankkártya adatai áruházunkhoz nem jutnak el.
                                </p>
                            </div>
                            <hr class="hr"/>
                            <div>
                                <h5 class="fw-bold">Teljes összeg</h5>
                                <p class="fs-5"><strong>{{ package.price|price }}</strong></p>
                            </div>

                            {#                        <div class="input-group mb-3"> #}
                            {#                            <input type="text" class="form-control" placeholder="Kuponkód" id="coupon-code"> #}
                            {#                            <button class="btn btn-primary" id="apply-coupon">Beváltás</button> #}
                            {#                        </div> #}

                            <hr class="hr"/>

                            <div class="form-check d-flex align-items-start mb-2">
                                <input type="checkbox"
                                       class="form-check-input mt-1 me-2 {% if validations.agree_aszf is defined %}{{ validations.agree_aszf }}{% endif %}"
                                       name="agree_aszf"
                                       id="agree_aszf"
                                       required
                                       {% if data.agree_aszf is defined and data.agree_aszf == true %}checked{% endif %}>
                                <label class="form-check-label" for="agree_aszf">
                                    Elolvastam és elfogadom az <a href="#" data-bs-toggle="modal" data-bs-target="#aszf_modal">ÁSZF</a>-et
                                </label>
                            </div>


                            <div class="form-check d-flex align-items-start mb-3">
                                <input type="checkbox"
                                       class="form-check-input mt-1 me-2 {% if validations.agree_privacy_statement is defined %}{{ validations.agree_privacy_statement }}{% endif %}"
                                       name="agree_privacy_statement"
                                       id="agree_privacy_statement"
                                       required
                                       {% if data.agree_privacy_statement is defined and data.agree_privacy_statement == true %}checked{% endif %}>
                                <label class="form-check-label" for="agree_privacy_statement">
                                    Elolvastam és elfogadom az <a href="#" data-bs-toggle="modal" data-bs-target="#privacy_statement_modal">Adatkezelési Nyilatkozat</a>-ot
                                </label>
                            </div>

                            <button class="btn btn-success w-100 g-recaptcha"
                                    data-sitekey="{{ recaptcha_site_key }}"
                                    data-callback='onSubmit'
                                    data-action='submit'>Megrendelés és fizetés indítása
                            </button>

                            {% if validations.recaptcha is defined and validations.recaptcha == 'is-invalid' %}
                                <div class="col-12">
                                    <div class="invalid-feedback d-block">reCAPTCHA ellenőrzés szükséges!</div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="aszf_modal" tabindex="-1" aria-labelledby="aszfModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="aszfModalLabel">Általános Szerződési Feltételek</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {% include 'information/aszf.html.twig' %}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bezár</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="privacy_statement_modal" tabindex="-1" aria-labelledby="privacyStatementModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="privacyStatementModalLabel">Adatkezelési Nyilatkozat</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    {% include 'information/privacy_statement.htm.twig' %}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bezár</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('#apply-coupon').click(function () {
                let coupon = $('#coupon-code').val();
                if (coupon.trim() === '') {
                    alert('Adj meg egy kuponkódot!');
                } else {
                    alert('Kuponkód alkalmazva: ' + coupon);
                }
            });
        });

        const openModals = document.querySelectorAll(".open-modal");
        const closeButtons = document.querySelectorAll(".close");

        openModals.forEach(link => {
            link.addEventListener("click", function(event) {
                event.preventDefault();
                const modalId = this.getAttribute("data-modal");
                document.getElementById(modalId).style.display = "block";
            });
        });

        closeButtons.forEach(button => {
            button.addEventListener("click", function() {
                this.closest(".modal").style.display = "none";
            });
        });

        window.addEventListener("click", function(event) {
            if (event.target.classList.contains("modal")) {
                event.target.style.display = "none";
            }
        });

        function onSubmit(token) {
            document.getElementById("checkout-form").submit();
        }
    </script>
{% endblock %}