{% extends 'base.html.twig' %}

{% block title %}Admin bejelentkezés{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center align-items-center vh-100 bg-light">
        <div class="card shadow-sm p-4" style="min-width: 350px; max-width: 400px;">
            <h1 class="h4 mb-4 text-center text-primary">Bejelentkezés az admin felületre</h1>

            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-3">
                    <label for="inputEmail" class="form-label">Email</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
                           class="form-control" autocomplete="email" required autofocus>
                </div>

                <div class="mb-3">
                    <label for="inputPassword" class="form-label">Jelszó</label>
                    <input type="password" name="password" id="inputPassword"
                           class="form-control" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token"
                       value="{{ csrf_token('authenticate') }}"
                >

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="_remember_me" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">Emlékezz rám</label>
                </div>

                <button class="btn btn-primary w-100" type="submit">Bejelentkezés</button>
            </form>

            {% if app.user %}
                <div class="text-center mt-3">
                    Bejelentkezve mint <strong>{{ app.user.userIdentifier }}</strong>,
                    <a href="{{ path('app_logout') }}">kijelentkezés</a>.
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
