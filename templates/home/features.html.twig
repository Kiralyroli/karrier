<script>
    $(document).ready(function () {
        const featureCard = $('.feature-card');
        featureCard.hover(
            function () {
                if ($(window).width() > 768) {
                    $(this).find('.feature-card-icon').stop(true, true).slideUp(500);
                    $(this).find('.feature-card-title').stop(true, true).slideUp(500);
                    $(this).find('.feature-card-description')
                        .stop(true, true)
                        .css('display', 'flex')
                        .hide()
                        .slideDown(500);
                }
            },
            function () {
                $(this).find('.feature-card-description').stop(true, true).slideUp(500);
                $(this).find('.feature-card-icon').stop(true, true).slideDown(500);
                $(this).find('.feature-card-title').stop(true, true).slideDown(500);
            }
        );

        featureCard.on('click', function () {
            if ($(window).width() <= 768) {
                $(this).find('.feature-card-icon').stop(true, true).slideUp(500);
                $(this).find('.feature-card-title').stop(true, true).slideUp(500);
                $(this).find('.feature-card-description')
                    .stop(true, true)
                    .css('display', 'flex')
                    .hide()
                    .slideDown(500);
            }
        });
    });
</script>