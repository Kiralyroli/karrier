        <div class="col-md-4">
            <div class="making-process-card">
                <div class="making-process-card-title">
                    <span>5</span>
                    <p>Önéletrajz kézbesítés</p>
                </div>
                <div class="making-process-card-description">
                    Az általad választott csomagtól függően 2-5 munkanapon belül elkészítjük a tökéletes önéletrajzodat,
                    amelyet e-mailben PDF formátumban küldünk el.
                </div>
                <div class="making-process-card-icon">
                    <img src="{{ asset('images/home/making_process/step5.svg') }}" alt="icon1">
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('.making-process-card').hover(
            function () {
                let icon = $(this).find('.making-process-card-icon img');
                let parentHeight = $(this).find('.making-process-card-icon').height();

                $(this).find('.making-process-card-title').hide();
                $(this).find('.making-process-card-description').stop(true, true).slideDown();
                $(this).find('.making-process-card-icon img').css({
                    'transform': `translateY(${parentHeight - icon.height()}px)`,
                });
            },
            function () {
                let card = $(this);
                card.find('.making-process-card-description').stop(true, true).slideUp(function () {
                    card.find('.making-process-card-title').show();
                });
                card.find('.making-process-card-icon img').css({
                    'transform': 'translateY(0)'
                });
            }
        );
    });
</script>