<div id="testimonial" class="container-fluid">
    <div class="container">
        <div class="testimonial-section">
            <h2>Ügyfeleink visszajelzései</h2>
            <div class="testimonial-slider">
                {% for testimonial in testimonials %}
                    <div class="testimonial-card">
                        <strong class="name">{{ testimonial.name }}</strong>
                        <div class="position">{{ testimonial.position }}</div>
                        <blockquote class="feedback">"{{ testimonial.feedback }}"</blockquote>
                        <div class="rating" aria-hidden="true">
                            {% for i in 1..5 %}
                                {% if i <= testimonial.rating %}
                                    <span>★</span>
                                {% else %}
                                    <span>☆</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        const slider = $(".testimonial-slider");
        let isDragging = false;
        let startX, scrollLeft;

        slider.on("mousedown touchstart", function (e) {
            isDragging = true;
            slider.addClass("grabbing");
            startX = e.pageX || e.originalEvent.touches[0].pageX;
            scrollLeft = slider.scrollLeft();
            e.preventDefault();
        });

        $(document).on("mousemove touchmove", function (e) {
            if (!isDragging) return;
            let x = e.pageX || e.originalEvent.touches[0].pageX;
            let walk = startX - x;
            slider.scrollLeft(scrollLeft + walk);
        });

        $(document).on("mouseup touchend", function () {
            isDragging = false;
            slider.removeClass("grabbing");
        });

        // Egérgörgővel való görgetés (blokk az oldal görgetése ellen)
        slider.on("wheel", function (e) {
            e.preventDefault();
            slider.stop().animate({ scrollLeft: `+=${e.originalEvent.deltaY * 2}` }, 100);
        });
    });
</script>