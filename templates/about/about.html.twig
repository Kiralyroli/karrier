{# templates/about/about.html.twig #}
{% extends 'base.html.twig' %}

{% block content %}
    <div id="about-page">
        <div class="row">
            <div id="image-content" class="col-5">
                <h1>Rólunk</h1>
                <img src="{{ asset('images/about/image1.png') }}" alt="image1">
                <img src="{{ asset('images/about/image2.png') }}" alt="image2">
                <img src="{{ asset('images/about/image3.png') }}" alt="image3">
            </div>
            <div id="description-content" class="col-7">
                <div class="row">
                    <div class="col-7">
                        <h2>
                            Az önéletrajz az első lépés a sikeres karrierhez – mi segítünk, hogy kiemelkedj.
                        </h2>
                    </div>
                    <p class="col-12">
                        A <i class="designed-text">Karrier Manufaktúra</i> célja, hogy segítsen azoknak, akik kiemelkedni szeretnének a munkaerőpiacon, és
                        valódi sikereket elérni a karrierjükben. Mi nem csak önéletrajzokat készítünk – mi professzionális,
                        személyre szabott karriereszközöket nyújtunk, amelyekkel magabiztosan léphetsz előre álmaid munkája
                        felé.
                    </p>
                    <p class="col-12">
                        Küldetésünk, hogy minden ügyfél számára olyan személyre szabott önéletrajzot készítsünk, amely
                        kiemeli őket a jelentkezők sorából, és egyenesen a figyelem középpontjába helyezi őket.<br>
                        Hisszük, hogy a sikeres karrierépítés az önéletrajz gondos megtervezésével és megalkotásával
                        kezdődik, és mi ezt biztosítjuk számodra.
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}