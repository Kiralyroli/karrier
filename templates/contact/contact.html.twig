{# templates/contact/contact.html.twig #}
{% extends 'base.html.twig' %}

{% block content %}
    <div id="contact-page">
        <div class="row">
            {% if successMessage %}
                <div class="alert alert-success alert-dismissible" role="alert">
                    <strong>{{ successMessage }}</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% elseif unSuccessMessage %}
                <div class="alert alert-danger alert-dismissible" role="alert">
                    <strong>{{ unSuccessMessage }}</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endif %}

            <div id="contact-form" class="col-6">
                <form action="" method="POST">
                    <div class="mb-3">
                        <label for="name" class="form-label">Teljes név</label>
                        <input type="text"
                               class="form-control form-control-lg{% if validations.name is defined %} {{ validations.name }}{% endif %}"
                               id="name" name="name" value="{{ formData.name|e }}"
                               aria-describedby="validationServerNameFeedback" required>
                        <div id="validationServerNameFeedback" class="invalid-feedback">A teljes név megadása
                            kötelező.
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 col-xl-6">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email"
                                       class="form-control form-control-lg{% if validations.email is defined %} {{ validations.email }}{% endif %}"
                                       id="email" name="email" value="{{ formData.email|e }}"
                                       aria-describedby="validationServerEmailFeedback" required>
                                <div id="validationServerEmailFeedback" class="invalid-feedback">Az email cím megadása
                                    kötelező.
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 col-xl-6">
                            <div class="mb-3">
                                <label for="phone" class="form-label">Telefonszám</label>
                                <input type="text"
                                       class="form-control form-control-lg{% if validations.phone is defined %} {{ validations.phone }}{% endif %}"
                                       id="phone" name="phone" value="{{ formData.phone|e }}"
                                       aria-describedby="validationServerPhoneFeedback" required>
                                <div id="validationServerPhoneFeedback" class="invalid-feedback">A telefonszám megadása
                                    kötelező.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label">Üzenet</label>
                        <textarea id="message"
                                  class="form-control form-control-lg{% if validations.message is defined %} {{ validations.message }}{% endif %}"
                                  name="message" aria-describedby="validationServerMessageFeedback"
                                  required>{{ formData.message|e }}</textarea>
                        <div id="validationServerMessageFeedback" class="invalid-feedback">Az üzenet megadása
                            kötelező.
                        </div>
                    </div>

                    <button type="submit">{{ 'Küldés'|upper }}</button>
                </form>
            </div>
            <div id="description" class="col-6">
                <div class="row">
                    <div class="col-12">
                        <h1>
                            Kapcsolat
                        </h1>
                    </div>
                    <p class="col-12 content">
                        Ha kérdése van, vagy segítségre van szüksége, vegye fel velünk a kapcsolatot.
                        Örömmel válaszolunk minden kérdésre a lehető leghamarabb.
                    </p>
                    <div id="contact-phone" class="col-12">
                        <p><a href="tel:+36303303584"><i class="bi bi-telephone"></i>+36303303584</a></p>
                    </div>
                    <div id="contact-email" class="col-12">
                        <p><i class="bi bi-envelope"></i>{{ contactEmail }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(".alert").delay(3500).slideUp(500, function () {
            $(this).alert('close');
        });

        $(document).ready(function () {
            $('#phone').on('input', function () {
                $(this).val($(this).val().replace(/[^0-9+\-]/g, ''));
            });
        });
    </script>
{% endblock %}