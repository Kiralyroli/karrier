{% extends 'base.html.twig' %}

{% block content %}
    <div id="contact-page" class="container">
        <div class="row justify-content-between">
            {% if successMessage %}
                <div>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>{{ successMessage }}</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
                    </div>
                </div>
            {% elseif unSuccessMessage %}
                <div>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>{{ unSuccessMessage }}</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
                    </div>
                </div>
            {% endif %}

            <div class="col-12">
                <div id="contact-title">
                    <h1 class="mb-2">Kapcsolatfelvétel</h1>
                    <p>Kérdésed van?<br>Töltsd ki az alábbi űrlapot, és csapatunk hamarosan felveszi veled a kapcsolatot.</p>
                </div>
            </div>

            <div class="col-lg-6">
                <form method="POST" id="contact-form" novalidate>
                    <div class="row g-3">
                        <div class="col-12">
                            <input type="text" name="name" aria-label="Teljes név"
                                   class="form-control {% if validations.name is defined %}{{ validations.name }}{% endif %}"
                                   placeholder="Teljes név"
                                   value="{{ formData.name|default('') }}"
                                   required>
                            <div class="invalid-feedback">Kérlek, add meg a nevedet!</div>
                        </div>

                        <div class="col-12">
                            <input type="email" name="email" aria-label="Email cím"
                                   class="form-control {% if validations.email is defined %}{{ validations.email }}{% endif %}"
                                   placeholder="Email cím"
                                   value="{{ formData.email|default('') }}"
                                   required>
                            <div class="invalid-feedback">Érvényes email cím szükséges!</div>
                        </div>

                        <div class="col-12">
                            <input type="text" name="phone" id="phone" aria-label="Telefonszám"
                                   class="form-control {% if validations.phone is defined %}{{ validations.phone }}{% endif %}"
                                   placeholder="Telefonszám"
                                   value="{{ formData.phone|default('') }}">
                        </div>

                        <div class="col-12">
                            <textarea name="message" aria-label="Üzenet" rows="5"
                                      class="form-control {% if validations.message is defined %}{{ validations.message }}{% endif %}"
                                      placeholder="Üzenet">{{ formData.message|default('') }}</textarea>
                            <div class="invalid-feedback">Kérlek, adj meg egy üzenetet!</div>
                        </div>

                        <div class="col-12 mt-2">
                            <button class="btn btn-primary g-recaptcha"
                                    data-sitekey="{{ recaptcha_site_key }}"
                                    data-callback='onSubmit'
                                    data-action='submit'
                                    type="submit">Elküld</button>
                        </div>

                        {% if validations.recaptcha is defined and validations.recaptcha == 'is-invalid' %}
                            <div class="col-12">
                                <div class="invalid-feedback d-block">reCAPTCHA ellenőrzés szükséges!</div>
                            </div>
                        {% endif %}
                    </div>
                </form>
            </div>

            <div class="col-lg-5 mt-5 mt-lg-0">
                <div id="description">
                    <p><i class="bi bi-envelope me-2"></i>{{ contactEmail }}</p>
                    <p id="contact-phone"><i class="bi bi-telephone me-2"></i><a href="tel:+36303303584" class="text-decoration-none">+36 30 330 3584</a></p>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const phoneInput = document.getElementById("phone");
            if (phoneInput) {
                phoneInput.addEventListener("input", function () {
                    this.value = this.value.replace(/[^0-9+\-]/g, '');
                });
            }
        });

        function onSubmit(token) {
            document.getElementById("contact-form").submit();
        }
    </script>
{% endblock %}